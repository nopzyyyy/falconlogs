# ==============================================================================
#                      MYSTERIO STOREFRONT & BOT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your custom credentials and tokens.

# --- SERVER & NETWORKING ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
PUBLIC_BASE_URL=https://mysterio.cc
STORE_NAME=Mysterio

# --- ADMIN & GOD CREDENTIALS (DASHBOARD LOGIN) ---
ADMIN_EMAIL=admin@mysterio.cc
ADMIN_PASSWORD=ChangeThisAdminPassword2026!
GOD_EMAIL=god@mysterio.cc
GOD_PASSWORD=ChangeThisGodPassword2026!

# --- TELEGRAM BOT TOKENS & CHAT IDS ---
# 1. Main Admin Notification Bot (sends real-time alerts for orders, refunds, topups)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_ADMIN_BOT_TOKEN_HERE
TELEGRAM_ADMIN_IDS=123456789,987654321

# 2. Public Channel Restock Bot (automatically posts restocks to public channel)
TELEGRAM_RESTOCK_BOT_TOKEN=YOUR_TELEGRAM_RESTOCK_BOT_TOKEN_HERE
RESTOCK_STORE_URL=mysterio.cc

# 3. User Dashboard Bot (handles Telegram Login and customer notifications)
DASHBOARD_BOT_TOKEN=YOUR_TELEGRAM_DASHBOARD_BOT_TOKEN_HERE

# 4. Gateway Access Verification Bot (human math captcha gating for Telegram channel)
GATEWAY_BOT_TOKEN=YOUR_TELEGRAM_GATEWAY_BOT_TOKEN_HERE
GATEWAY_NAME=mysteriogateway

# 5. Telegram Stars Payments Bot (in-app Telegram Stars payments & automated topups)
PAYMENTS_BOT_TOKEN=YOUR_TELEGRAM_PAYMENTS_BOT_TOKEN_HERE
STARS_SECRET=MysterioStarsSecret2026

# 6. Automated Replacements Bot (handles customer replacement claims)
REPLACEMENT_BOT_TOKEN=YOUR_TELEGRAM_REPLACEMENT_BOT_TOKEN_HERE
REPLACEMENT_BOT_USERNAME=mysterio_replacement_bot
REPLACEMENT_SECRET=MysterioReplacementSecret2026

# 7. Success Bot (posts verified purchase vouches/proofs to public channel)
SUCCESS_BOT_TOKEN=YOUR_TELEGRAM_SUCCESS_BOT_TOKEN_HERE

# --- PAYMENT GATEWAY CONFIGURATIONS ---
# NOWPayments (Crypto Invoicing & Direct Payments)
NOWPAYMENTS_TOPUP_API_KEY=YOUR_NOWPAYMENTS_TOPUP_API_KEY_HERE
NOWPAYMENTS_ORDER_API_KEY=YOUR_NOWPAYMENTS_ORDER_API_KEY_HERE
NOWPAYMENTS_IPN_SECRET=YOUR_NOWPAYMENTS_IPN_SECRET_HERE
NOWPAYMENTS_URL=https://api.nowpayments.io/v1

# Chime Automated Email Matching System
CHIME_EMAIL=mysterio.payments@gmail.com
CHIME_EMAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE
CHIME_IMAP_SERVER=imap.gmail.com
CHIME_IMAP_PORT=993
CHIME_WEBHOOK_URL=http://localhost:3001/api/payments/chime-webhook
CHIME_WEBHOOK_TOKEN=mysterio_chime_secure_token_2026

# --- BANK IDENTIFICATION NUMBER (BIN) LOOKUP API ---
# HandyAPI for auto-enriching card schemes, tiers, issuers from 6-digit BIN
HANDYAPI_KEY=YOUR_HANDYAPI_KEY_HERE

# --- TELEGRAM USERBOT / FORWARDER DAEMON (Telethon) ---
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION_NAME=mysterio_session
